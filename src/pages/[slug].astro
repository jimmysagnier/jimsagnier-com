---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Essentiel from '../components/content/Essentiel.astro';
import AISummary from '../components/content/AISummary.astro';
import { getSiteSettings, getJimPerson } from '../lib/site';
import { blogPostingNode, howToNode, faqPageNode, type SchemaNode } from '../lib/schema';

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const now = new Date();
  const articles = await getCollection('articles', ({ data }) => {
    if (isDev) return true;
    if (data.draft) return false;
    // Vérifier que la date de publication planifiée est passée (ou non définie)
    if (data.scheduledPublishAt && data.scheduledPublishAt > now) return false;
    return true;
  });
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const tocItems = headings.filter((h) => h.depth === 2);
const settings = getSiteSettings();
const author = getJimPerson();
const url = `${settings.baseUrl}/${article.id}/`;

const territoryLabels = {
  construire: 'Construire',
  comprendre: 'Comprendre',
  reflechir: 'Réfléchir',
} as const;

const dateFormatter = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schemaType = article.data.seo?.schemaType ?? 'BlogPosting';
const schemaNodes: SchemaNode[] = [blogPostingNode({ article, url })];
if (schemaType === 'HowTo' && article.data.howTo?.steps?.length) {
  schemaNodes.push(howToNode({ article, url }));
}
if (schemaType === 'FAQPage' && article.data.faq?.length) {
  schemaNodes.push(faqPageNode({ article, url }));
}

const breadcrumbs = [
  { name: 'Atelier', url: settings.baseUrl },
  { name: 'Journal', url: `${settings.baseUrl}/journal` },
  { name: article.data.title, url },
];

const cover = article.data.coverImage;
const ogImage = article.data.seo?.ogImage ?? cover.src;

// Petit helper Markdown inline (gras + italique) pour les items de l'Essentiel
const inlineMd = (s: string) =>
  s
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');
---
<BaseLayout
  title={article.data.title}
  description={article.data.seo?.description ?? article.data.summary}
  ogImage={ogImage.startsWith('http') ? ogImage : `${settings.baseUrl}${ogImage}`}
  noindex={article.data.seo?.noindex ?? false}
  canonical={url}
  active="journal"
  breadcrumbs={breadcrumbs}
  schemaNodes={schemaNodes}
>
  <div class="reading-progress" aria-hidden="true"><span id="reading-bar"></span></div>

  <article>
    <header class="post-head">
      <nav aria-label="Fil d'Ariane" class="breadcrumb post-crumb">
        <a href="/" class="home">Atelier</a>
        <span class="sep">/</span>
        <a href="/journal">Journal</a>
        <span class="sep">/</span>
        <a href={`/journal#${article.data.territory}`} class={`terr-tag ${article.data.territory}`}>
          {territoryLabels[article.data.territory]}
        </a>
      </nav>

      <h1>{article.data.title}</h1>
      <p class="lede">{article.data.summary}</p>

      <div class="meta-pill">
        <span class="author">
          <span class="avatar" aria-hidden="true"></span>
          <b>{author.name}</b>
        </span>
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={article.data.publishedAt.toISOString()}>
          {dateFormatter.format(article.data.publishedAt)}
        </time>
        {article.data.readingTime && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <span>{article.data.readingTime} min de lecture</span>
          </>
        )}
        {article.data.draft && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <span class="draft-tag">Brouillon</span>
          </>
        )}
      </div>
    </header>

    {article.data.essentiel && article.data.essentiel.items.length > 0 && (
      <Essentiel
        sousTitre={article.data.essentiel.sousTitre}
        readingTime={article.data.essentiel.readingTime}
      >
        <ul>
          {article.data.essentiel.items.map((item) => (
            <li set:html={inlineMd(item)} />
          ))}
        </ul>
      </Essentiel>
    )}

    <AISummary articleTitle={article.data.title} />

    <div class="layout">
      {tocItems.length > 0 && (
        <aside class="toc" aria-label="Sommaire">
          <h4>
            <span class="label-txt">Sommaire</span>
            <span class="progress-pct" id="toc-progress">0%</span>
          </h4>
          <ol>
            {tocItems.map((h, i) => (
              <li>
                <a href={`#${h.slug}`}>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="title">{h.text}</span>
                </a>
              </li>
            ))}
          </ol>
          <div class="toc-actions">
            <h5>Actions</h5>
            <a href={`#${tocItems[0]?.slug ?? 'top'}`}><span class="ico">↑</span> Retour en haut</a>
            <a href="https://jsagnier.substack.com" target="_blank" rel="noopener"><span class="ico">↗</span> Newsletter</a>
          </div>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="post-footer">
      {article.data.tags.length > 0 && (
        <div class="tags-row">
          <span class="lbl">Tags</span>
          {article.data.tags.map((tag) => (
            <a href={`/journal?tag=${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      )}

      <div class="author-card">
        <div class="photo" aria-hidden="true"></div>
        <div>
          <h4>{author.name}</h4>
          <div class="role">{author.jobTitle} · acquisition · IA · SEO</div>
          <p>{author.description}</p>
          <div class="links">
            <a href="/a-propos">parcours</a>
            <a href="/projets">projets</a>
            <a href="https://jsagnier.substack.com" target="_blank" rel="noopener">newsletter</a>
          </div>
        </div>
      </div>

      <div class="news-inline">
        <h3>Reçois les prochains articles directement.</h3>
        <p>La newsletter du Journal, sans calendrier forcé. Quand un texte mérite la peine, je l'envoie. Pas avant.</p>
        <a class="news-cta" href="https://jsagnier.substack.com" target="_blank" rel="noopener">
          S'abonner sur Substack →
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    // Reading progress bar
    const bar = document.getElementById('reading-bar');
    if (!bar) return; // pas une page article
    function updateBar() {
      if (!bar) return;
      const h = document.documentElement;
      const total = h.scrollHeight - h.clientHeight;
      const p = total > 0 ? (h.scrollTop / total) * 100 : 0;
      bar.style.width = Math.min(100, Math.max(0, p)) + '%';
    }
    const onScroll = () => updateBar();
    document.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('scroll', onScroll);
    }, { once: true });
    updateBar();

    // TOC active + progression
    const headings = document.querySelectorAll<HTMLHeadingElement>('.prose h2[id]');
    const tocItems = document.querySelectorAll<HTMLLIElement>('.toc li');
    const tocProgress = document.getElementById('toc-progress');

    function updateToc(currentId: string) {
      let currentIndex = 0;
      tocItems.forEach((li, idx) => {
        const a = li.querySelector('a');
        const isCurrent = a?.getAttribute('href') === '#' + currentId;
        if (isCurrent) currentIndex = idx;
        li.classList.toggle('current', !!isCurrent);
      });
      tocItems.forEach((li, idx) => li.classList.toggle('read', idx < currentIndex));
      if (tocProgress) {
        const total = tocItems.length;
        const pct = Math.round(((currentIndex + 1) / total) * 100);
        tocProgress.textContent = pct + '%';
      }
    }

    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) updateToc(e.target.id);
        });
      }, { rootMargin: '-100px 0px -60% 0px' });
      headings.forEach((h) => obs.observe(h));
      document.addEventListener('astro:before-swap', () => obs.disconnect(), { once: true });
    }
  });
</script>

<style>
  /* ============== reading progress bar ============== */
  .reading-progress {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    height: 2px; background: transparent; pointer-events: none;
  }
  .reading-progress > span {
    display: block; height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    width: 0%; transition: width .15s linear;
  }

  /* ============== article header centered ============== */
  .post-head {
    max-width: 920px; margin: 0 auto;
    padding: 96px 48px 48px;
    text-align: center;
  }
  .post-crumb {
    padding: 0 0 16px 0; max-width: none; justify-content: center;
  }
  .post-crumb .terr-tag {
    font-size: 11px; padding: 3px 8px; border-radius: 4px;
    background: rgba(6,182,212,.08);
    border: 1px solid rgba(6,182,212,.2);
    letter-spacing: .08em;
  }
  .post-crumb .terr-tag.comprendre {
    background: color-mix(in srgb, var(--warm) 8%, transparent);
    border-color: color-mix(in srgb, var(--warm) 22%, transparent);
  }
  .post-crumb .terr-tag.reflechir {
    background: color-mix(in srgb, var(--purple) 8%, transparent);
    border-color: color-mix(in srgb, var(--purple) 22%, transparent);
  }
  .post-head h1 {
    font-size: clamp(36px, 5.6vw, 64px);
    line-height: 1.1; letter-spacing: -.025em;
    font-weight: 600; margin-top: 24px;
    max-width: 22ch; margin-left: auto; margin-right: auto;
  }
  .post-head .lede {
    font-size: 19px; line-height: 1.55;
    color: var(--fg-dim); margin-top: 24px;
    max-width: 56ch; margin-left: auto; margin-right: auto;
  }
  .meta-pill {
    display: inline-flex; gap: 12px; align-items: center;
    margin-top: 36px;
    padding: 10px 18px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--bg-2);
    font-size: 13px; color: var(--fg-dim);
    flex-wrap: wrap; justify-content: center;
  }
  .meta-pill .author {
    display: inline-flex; align-items: center; gap: 8px;
  }
  .meta-pill .avatar {
    width: 22px; height: 22px; border-radius: 50%;
    background-color: var(--bg-3);
    background-size: cover; background-position: center;
    background-image: image-set(
      url("/images/jim-avatar.webp") type("image/webp"),
      url("/images/jim-avatar.jpg") type("image/jpeg")
    );
  }
  .meta-pill .author b { color: var(--fg); font-weight: 500; }
  .meta-pill .sep { color: var(--fg-mute); }
  .draft-tag {
    background: var(--warm); color: white;
    padding: 2px 8px; border-radius: 4px;
    font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
    font-family: var(--mono);
  }

  /* ============== layout (TOC + prose) ============== */
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 720px);
    gap: 40px;
    max-width: 1040px; margin: 0 auto;
    padding: 80px 48px 64px;
    align-items: start;
  }

  /* TOC sidebar avec rail + dots */
  .toc {
    grid-column: 1;
    position: sticky; top: 100px; align-self: start;
    background: var(--bg);
    border: 1px solid rgba(6,182,212,.22);
    border-radius: 18px;
    padding: 22px 22px 18px;
    box-shadow:
      0 0 0 1px rgba(6,182,212,.04),
      0 0 50px -8px rgba(6,182,212,.18),
      0 30px 60px -28px rgba(0,0,0,.12),
      inset 0 1px 0 rgba(255,255,255,.5);
    transition: box-shadow .35s;
  }
  .toc:hover {
    box-shadow:
      0 0 0 1px rgba(6,182,212,.08),
      0 0 70px -8px rgba(6,182,212,.28),
      0 36px 70px -28px rgba(0,0,0,.16),
      inset 0 1px 0 rgba(255,255,255,.5);
  }
  .toc h4 {
    font-family: var(--mono); font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--fg-mute); margin: 0 0 20px;
    display: flex; align-items: center; gap: 10px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--line);
    font-weight: 500;
  }
  .toc h4::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 0 3px rgba(6,182,212,.18);
    flex-shrink: 0;
  }
  .toc h4 .label-txt { flex: 1; }
  .toc h4 .progress-pct {
    margin-left: auto;
    font-family: var(--mono); font-size: 10px;
    color: var(--accent); font-weight: 600;
    letter-spacing: 0;
    padding: 2px 7px; border-radius: 4px;
    background: rgba(6,182,212,.1);
  }
  .toc ol {
    list-style: none; padding-left: 26px;
    position: relative; margin: 0;
  }
  .toc ol::before {
    content: ''; position: absolute;
    left: 6px; top: 12px; bottom: 12px;
    width: 2px; background: var(--line);
    border-radius: 2px;
  }
  .toc li {
    position: relative;
    padding: 9px 0;
    line-height: 1.35;
    transition: padding .25s;
  }
  .toc li::before {
    content: ''; position: absolute;
    left: -26px; top: 13px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    transition: all .3s cubic-bezier(.2,.8,.2,1);
    box-sizing: border-box;
  }
  .toc a {
    display: flex; gap: 10px; align-items: baseline;
    color: var(--fg-dim);
    transition: color .2s;
    font-size: 13px;
  }
  .toc a .num {
    font-family: var(--mono); font-size: 10px;
    color: var(--fg-mute);
    transition: color .2s;
    flex-shrink: 0;
  }
  .toc a .title { flex: 1; }
  .toc li:hover::before {
    border-color: var(--accent);
    transform: scale(1.2);
  }
  .toc li:hover a { color: var(--fg); }
  .toc li:hover a .num { color: var(--accent); }
  .toc li.read::before {
    background: var(--fg-mute);
    border-color: var(--fg-mute);
  }
  .toc li.read a, .toc li.read a .num { color: var(--fg-mute); }
  .toc li.current::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(6,182,212,.18);
    animation: tocPulse 2s ease-in-out infinite;
  }
  @keyframes tocPulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(6,182,212,.18); }
    50% { box-shadow: 0 0 0 7px rgba(6,182,212,.08); }
  }
  .toc li.current a { color: var(--fg); font-weight: 600; }
  .toc li.current a .num { color: var(--accent); }
  .toc li.current { padding-left: 4px; }

  .toc-actions {
    margin-top: 18px; padding-top: 16px;
    border-top: 1px dashed var(--line);
    display: flex; flex-direction: column; gap: 2px;
  }
  .toc-actions h5 {
    font-family: var(--mono); font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--fg-mute); margin: 0 0 6px;
    font-weight: 500;
  }
  .toc-actions a {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 6px; border-radius: 6px;
    color: var(--fg-dim); font-size: 13px;
    transition: all .15s;
  }
  .toc-actions a:hover {
    background: var(--bg-2); color: var(--fg);
  }
  .toc-actions a .ico {
    width: 16px; height: 16px;
    display: grid; place-items: center;
    border-radius: 4px; background: var(--bg-2);
    border: 1px solid var(--line);
    font-size: 10px; flex-shrink: 0;
    color: var(--fg-mute);
    transition: all .15s;
  }
  .toc-actions a:hover .ico {
    background: var(--bg);
    color: var(--accent);
    border-color: rgba(6,182,212,.3);
  }

  /* ============== prose (reading experience) ============== */
  .prose {
    grid-column: 2;
    font-size: 18px; line-height: 1.75; color: var(--fg);
    max-width: 720px;
    counter-reset: section;
  }
  .prose > *:first-child { margin-top: 0 !important; }
  .prose > * + * { margin-top: 1.4em; }
  .prose :global(p) { color: var(--fg); margin: 1.4em 0 0; }
  /* premier paragraphe de la prose = lead avec drop cap */
  .prose :global(> p:first-of-type) {
    font-size: 22px; line-height: 1.55;
    color: var(--fg);
    margin-top: 0;
  }
  .prose :global(> p:first-of-type::first-letter) {
    font-size: 3em; float: left; line-height: 1;
    margin: .08em .12em -.05em 0;
    font-weight: 600; color: var(--fg);
  }
  .prose :global(h2) {
    font-size: 30px; letter-spacing: -.02em; font-weight: 600;
    line-height: 1.2; margin: 2.4em 0 0;
    scroll-margin-top: 100px;
    counter-increment: section;
  }
  .prose :global(h2)::before {
    content: counter(section, decimal-leading-zero);
    font-family: var(--mono); font-size: 16px;
    color: var(--fg-mute); margin-right: 12px;
    font-weight: 400;
  }
  .prose :global(h3) {
    font-size: 22px; letter-spacing: -.015em; font-weight: 600;
    margin: 2em 0 0;
  }
  .prose :global(p a),
  .prose :global(li a),
  .prose :global(td a) {
    color: var(--fg);
    border-bottom: 1px solid var(--accent);
    transition: background .2s;
  }
  .prose :global(p a:hover),
  .prose :global(li a:hover),
  .prose :global(td a:hover) {
    background: linear-gradient(transparent 70%, rgba(6,182,212,.25) 0);
  }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 28px;
  }
  .prose :global(li) { margin-top: .6em; }
  .prose :global(ul li::marker) { color: var(--accent); }

  .prose :global(blockquote) {
    margin: 2em 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--accent);
    font-size: 22px; line-height: 1.5;
    font-style: italic; color: var(--fg);
  }

  /* code blocks (terminal) */
  .prose :global(pre) {
    margin: 2em 0;
    background: #18181B; color: #E4E4E7;
    border-radius: 12px; padding: 24px;
    font-family: var(--mono); font-size: 14px; line-height: 1.6;
    overflow-x: auto;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.04);
    position: relative; padding-top: 48px;
  }
  .prose :global(pre)::before {
    content: '';
    position: absolute; top: 16px; left: 18px;
    width: 12px; height: 12px; border-radius: 50%;
    background: #ef4444;
    box-shadow: 18px 0 0 #eab308, 36px 0 0 #22c55e;
  }
  .prose :global(code) {
    font-family: var(--mono); font-size: .88em;
    background: var(--bg-2); padding: 2px 6px; border-radius: 4px;
    border: 1px solid var(--line);
  }
  .prose :global(pre code) {
    background: transparent; padding: 0; border: 0;
    border-radius: 0; font-size: 1em;
  }

  /* figures */
  .prose :global(figure) { margin: 2em 0; }
  .prose :global(img) {
    border-radius: 16px;
    width: 100%; height: auto;
  }
  .prose :global(figcaption) {
    margin-top: 12px; font-size: 13px; color: var(--fg-mute);
    text-align: center; font-family: var(--mono);
  }

  /* ============== post-footer ============== */
  .post-footer {
    border-top: 1px solid var(--line);
    padding: 64px 48px;
    max-width: var(--max); margin: 0 auto;
  }
  .tags-row {
    max-width: 720px; margin: 0 auto;
    display: flex; gap: 8px; flex-wrap: wrap;
    align-items: center;
  }
  .tags-row .lbl {
    font-family: var(--mono); font-size: 11px;
    color: var(--fg-mute); letter-spacing: .12em;
    text-transform: uppercase; margin-right: 8px;
  }
  .tags-row a {
    padding: 6px 12px; border-radius: 6px;
    background: var(--bg-2); border: 1px solid var(--line);
    color: var(--fg-dim); font-size: 13px;
    transition: all .2s;
  }
  .tags-row a:hover {
    background: var(--bg); border-color: var(--fg-mute); color: var(--fg);
  }

  .author-card {
    max-width: 720px; margin: 56px auto 0;
    display: grid; grid-template-columns: auto 1fr; gap: 24px;
    padding: 28px;
    border: 1px solid var(--line); border-radius: 18px;
    background: var(--bg);
    align-items: center;
  }
  .author-card .photo {
    width: 88px; height: 88px; border-radius: 50%;
    background-color: var(--bg-3);
    background-size: cover; background-position: center;
    background-image: image-set(
      url("/images/jim-avatar.webp") type("image/webp"),
      url("/images/jim-avatar.jpg") type("image/jpeg")
    );
    box-shadow: 0 0 0 4px rgba(6,182,212,.12);
  }
  .author-card h4 {
    font-size: 18px; font-weight: 600; letter-spacing: -.01em;
    margin: 0;
  }
  .author-card .role {
    font-size: 13px; color: var(--accent); font-family: var(--mono);
    letter-spacing: .04em; margin-top: 2px;
  }
  .author-card p {
    color: var(--fg-dim); font-size: 14px; line-height: 1.55;
    margin-top: 8px;
  }
  .author-card .links {
    margin-top: 12px; display: flex; gap: 16px;
    font-family: var(--mono); font-size: 12px;
  }
  .author-card .links a {
    color: var(--fg-dim); transition: color .2s;
    display: inline-flex; gap: 4px;
  }
  .author-card .links a:hover { color: var(--fg); }
  .author-card .links a::before { content: '↗ '; color: var(--fg-mute); }

  .news-inline {
    max-width: 720px; margin: 56px auto 0;
