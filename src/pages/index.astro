---
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getProjects} from '../lib/projects';
const projects = await getProjects();
const project = (id:string)=>projects.find(p=>p.slug===id)!;
const now=new Date();
const articles=await getCollection('articles',({data})=>!data.draft && data.publishedAt<=now && (!data.scheduledPublishAt || data.scheduledPublishAt<=now));
const selected=['vibecoder-site-claude','usine-skills-claude-mcp','cocon-semantique-maillage-echelle'].map(id=>articles.find(a=>a.id===id)).filter((a):a is NonNullable<typeof a>=>Boolean(a));
---
<BaseLayout active="atelier" title="L’atelier" description="Jim Sagnier, Lead acquisition chez Eurofiscalis. SEO, IA appliquée, applications macOS, SaaS et bibliothèque personnelle." lcpImage="/images/jim-coding.webp">
<div class="network-shell">
<section class="network-hero"><div class="intro-person"><span class="location"><span aria-hidden="true"></span>Lyon, France</span><h1>Jim Sagnier<span>.</span></h1><p class="lead-role">Lead acquisition chez Eurofiscalis.<br>Je construis aussi mes propres outils.</p><p class="personal-bio">Du SEO, de l’IA appliquée, des sites web, des applications macOS et des SaaS. Ici, je documente ce que je construis, ce que j’apprends et les idées que je relie.</p><div class="practice-tags"><span>SEO</span><span>IA appliquée</span><span>Web</span><span>Second Cerveau</span></div><div class="person-actions"><a href="/projets/" class="primary-action">Explorer mes projets <span aria-hidden="true">↗</span></a><a href="/a-propos/" class="quiet-action">Qui est Jim ?</a></div><div class="profile-links"><a href="https://github.com/jimmysagnier/" target="_blank" rel="noopener me">GitHub ↗</a><a href="https://www.linkedin.com/in/jimmysagnier/" target="_blank" rel="noopener me">LinkedIn ↗</a><a href="/a-propos/">Mon parcours →</a></div></div>
<div class="atelier-visual"><figure class="atelier-photo"><img src="/images/jim-coding.webp" alt="Jim Sagnier au travail dans son atelier" width="640" height="420" fetchpriority="high"><figcaption><span class="photo-status" aria-hidden="true"></span>Dans l’atelier.</figcaption></figure><div class="atelier-tools"><div class="tool-column"><span class="tool-category">Applications macOS</span><ProjectCard project={project('mycockpit')} compact/><ProjectCard project={project('athla')} compact/></div><div class="tool-column"><span class="tool-category">Outils SaaS</span><ProjectCard project={project('intento')} compact/><ProjectCard project={project('trakkeon')} compact/></div></div><div class="atelier-links"><a href="/projets/second-cerveau-mcp/">Second Cerveau <span aria-hidden="true">↗</span></a><span aria-hidden="true">·</span><a href="/projets/">Web & autres projets <span aria-hidden="true">↗</span></a></div></div>
</section>
<div class="credibility-strip"><span><b>10 ans</b> de pratique SEO</span><span><b>Lead acquisition</b> chez Eurofiscalis</span><span><b>Des outils</b> que je développe et documente</span></div>
<section class="personal-projects"><div class="section-heading"><div><span class="eyebrow">Ce que je construis</span><h2>Mes outils. Mes terrains d’essai.</h2><p>Les projets perso prolongent ce que je fais au quotidien.</p></div><a href="/projets/">Tous les projets ↗</a></div><div class="focus-grid">{['mycockpit','intento','athla','trakkeon'].map(id=><ProjectCard project={project(id)}/>)}</div></section>
<section class="practice-proof"><div><span class="eyebrow">Mon travail</span><h2>L’acquisition, sur le terrain.</h2><p>Chez Eurofiscalis, je travaille sur le site, le SEO, le marketing et les échanges commerciaux. La refonte est collective, avec Kévin au design et Max au développement.</p><a href="/projets/eurofiscalis-refonte/">Ma contribution chez Eurofiscalis ↗</a></div><img src="/images/jim-coding.webp" alt="Jim au travail devant son ordinateur" loading="lazy" width="500" height="330"></section>
<section class="trace-section"><div class="section-heading"><div><span class="eyebrow">Ce que je transmets</span><h2>Les idées, avec leur contexte.</h2><p>Des textes écrits par Jim, à partir des projets et du travail réel.</p></div><a href="/journal/">Mes textes ↗</a></div><div class="entry-grid">{selected.map(article=><ArticleCard article={article} projects={projects}/>)}</div></section>
</div>
</BaseLayout>
