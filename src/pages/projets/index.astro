---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {getProjects, PROJECT_GROUPS} from '../../lib/projects';
import {getSiteSettings} from '../../lib/site';
const projects=await getProjects();
const settings=getSiteSettings();
---
<BaseLayout title="Projets" description="Les applications macOS, SaaS, sites web et projets documentés par Jim Sagnier." active="projets" breadcrumbs={[{name:'Atelier',url:settings.baseUrl},{name:'Projets',url:`${settings.baseUrl}/projets/`}]}>
<div class="network-shell"><header class="page-intro"><span class="eyebrow">Les fils de l’atelier</span><h1>Projets.</h1><p>Applications macOS, SaaS, web et connaissance : les outils que je construis et les projets auxquels je contribue.</p></header><div class="project-directory">{Object.entries(PROJECT_GROUPS).map(([group,label])=>{const items=projects.filter(p=>(p.group??'web')===group);return items.length>0 && <section><h2>{label}</h2><div class="focus-grid">{items.map(project=><ProjectCard project={project}/>)}</div></section>})}</div></div>
</BaseLayout>
