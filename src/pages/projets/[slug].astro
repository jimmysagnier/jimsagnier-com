---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {getProjects,getArticlesForProject,type SiteProject} from '../../lib/projects';
import {getSiteSettings} from '../../lib/site';
import {creativeWorkNode} from '../../lib/schema';
export async function getStaticPaths(){return (await getProjects()).map(project=>({params:{slug:project.slug},props:{project}}))}
interface Props {project:SiteProject}
const {project:p}=Astro.props;
const settings=getSiteSettings();
const url=`${settings.baseUrl}/projets/${p.slug}/`;
const articles=await getArticlesForProject(p.slug);
const projects=await getProjects();
const summary=p.summary.replace(/<[^>]*>/g,'');
const schemaNodes=[creativeWorkNode({projet:{data:{title:p.title,summary,status:p.status,stack:p.stack??[]}},url})];
---
<BaseLayout title={p.title} description={summary} active="projets" breadcrumbs={[{name:'Atelier',url:settings.baseUrl},{name:'Projets',url:`${settings.baseUrl}/projets/`},{name:p.title,url}]} schemaNodes={schemaNodes}>
<div class="network-shell"><section class="project-detail"><a class="back-link" href="/projets/">← Mes projets</a><span class="project-monogram big" aria-hidden="true">{p.initial??p.title.slice(0,2)}</span><span class="eyebrow">{p.kind??p.type}</span><h1>{p.title}</h1><p class="project-intro" set:html={p.summary}/><div class="author-contribution"><img src="/images/jim-avatar.webp" width="60" height="60" alt="Jim Sagnier"><div><b>Mon rôle dans ce projet</b><p>{p.role}</p></div></div>
{(p.stack?.length||p.subProjects?.length) && <section class="project-tools"><h2>Les choix de fabrication</h2>{p.subProjects?.length && <ul>{p.subProjects.map(sp=><li><strong>{sp.title}</strong>{sp.description && <p>{sp.description}</p>}</li>)}</ul>}{p.stack?.length && <div class="practice-tags">{p.stack.map(tool=><span>{tool}</span>)}</div>}</section>}
{articles.length?<><div class="section-heading"><h2>Ce que j’en ai écrit</h2><span>{articles.length} textes</span></div><div class="entry-grid">{articles.map(article=><ArticleCard article={article} projects={projects}/>)}</div></>:<div class="honest-note"><b>Le récit reste à écrire.</b><p>Le projet est présenté ici. Je n’ai pas encore publié de retour d’expérience dans cette bibliothèque.</p></div>}
</section></div>
</BaseLayout>
