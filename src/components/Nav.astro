---
type NavKey = 'atelier' | 'journal' | 'projets' | 'a-propos';
interface Props { active?: NavKey }
const { active } = Astro.props;
const links = [
  { href: '/', label: 'L’atelier', key: 'atelier' },
  { href: '/journal/', label: 'Bibliothèque', key: 'journal' },
  { href: '/projets/', label: 'Projets', key: 'projets' },
  { href: '/a-propos/', label: 'À propos', key: 'a-propos' },
];
---
<nav class="site" aria-label="Navigation principale">
  <a href="/" class="brand">
    <span class="avatar" aria-hidden="true"></span>
    Jim Sagnier
  </a>
  <ul class="desktop-links">
    {links.map((link) => <li><a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a></li>)}
  </ul>
</nav>
