---
interface Props {
  titre?: string;
  sousTitre?: string;
  readingTime?: string;
}
const {
  titre = "L'essentiel",
  sousTitre = "Les points essentiels.",
  readingTime,
} = Astro.props;
---
<aside class="block-essentiel" aria-label={titre}>
  <div class="ess-head">
    <span class="ess-label">{titre}</span>
    {readingTime && <span class="ess-reading-time">{readingTime}</span>}
  </div>
  <h3>{sousTitre}</h3>
  <div class="ess-body"><slot /></div>
</aside>

<style>
  .block-essentiel {
    max-width: 920px; margin: 32px auto 0;
    padding: 28px 32px;
    background: linear-gradient(135deg, rgba(6,182,212,.04), rgba(6,182,212,.01));
    border: 1px solid rgba(6,182,212,.18);
    border-left: 3px solid var(--accent);
    border-radius: 14px;
  }
  .ess-head {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 14px;
  }
  .ess-label {
    font-family: var(--mono); font-size: 11px;
    color: var(--accent); letter-spacing: .14em;
    text-transform: uppercase; font-weight: 600;
    padding: 4px 10px; border-radius: 5px;
    background: rgba(6,182,212,.1);
    border: 1px solid rgba(6,182,212,.25);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .ess-label::before {
    content: '◆'; color: var(--accent); font-size: 10px;
  }
  .ess-reading-time {
    font-family: var(--mono); font-size: 12px;
    color: var(--fg-mute);
    margin-left: auto;
  }
  .block-essentiel h3 {
    font-size: 20px; font-weight: 600; letter-spacing: -.015em;
    line-height: 1.25; margin: 0 0 14px;
  }
  .ess-body :global(ul) {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .ess-body :global(li) {
    position: relative;
    padding-left: 28px;
    font-size: 15px; line-height: 1.55;
    color: var(--fg);
  }
  .ess-body :global(li)::before {
    content: '→';
    position: absolute; left: 0; top: 1px;
    color: var(--accent); font-weight: 600;
    font-family: var(--mono);
  }
  .ess-body :global(li > p) { margin: 0; }
  .ess-body :global(strong) { font-weight: 600; }
  .ess-body :global(em) { font-style: italic; color: var(--fg-dim); }

  @media (max-width: 760px) {
    .block-essentiel { padding: 22px 20px; margin-top: 24px; }
    .ess-reading-time { display: none; }
  }
</style>
